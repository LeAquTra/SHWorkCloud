<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.1</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <groupId>com.LeAquTra</groupId>
    <artifactId>SHWorkCloud</artifactId>
    <version>0.0.1-SNAPSHOT</version>
    <name>SHWorkCloud</name>
    <description>作业云盘 —— 学生机房课堂文件保存系统</description>

    <properties>
        <java.version>17</java.version>
        <mybatis-plus.version>3.5.15</mybatis-plus.version>
        <sa-token.version>1.45.0</sa-token.version>
        <aliyun-oss.version>3.17.4</aliyun-oss.version>
        <aliyun-java-sdk-core.version>4.5.10</aliyun-java-sdk-core.version>
        <hutool.version>5.8.38</hutool.version>
        <poi.version>5.2.5</poi.version>

        <!--
          离线构建适配（环境说明，修复本地仓库后可整段删除）

          本机无外网，且本地仓库中 Boot 4.1.1 默认固定的生命周期插件版本不完整
          （例如 maven-filtering:3.5.0 只有 pom、没有 jar），因此把插件版本下调到
          本机已完整缓存的版本（即 Boot 3.5.15 使用的那一套）。
          待本地仓库补全或恢复外网后，删除下面 7 行即可回到 Boot 4.1.1 默认版本。
        -->
        <maven-clean-plugin.version>3.4.1</maven-clean-plugin.version>
        <maven-compiler-plugin.version>3.14.1</maven-compiler-plugin.version>
        <maven-deploy-plugin.version>3.1.4</maven-deploy-plugin.version>
        <maven-install-plugin.version>3.1.4</maven-install-plugin.version>
        <maven-jar-plugin.version>3.4.2</maven-jar-plugin.version>
        <maven-resources-plugin.version>3.3.1</maven-resources-plugin.version>
        <maven-surefire-plugin.version>3.5.6</maven-surefire-plugin.version>
    </properties>

    <!-- MyBatis-Plus BOM：统一管理 mybatis-plus-* 与 mybatis-plus-jsqlparser 的版本 -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>com.baomidou</groupId>
                <artifactId>mybatis-plus-bom</artifactId>
                <version>${mybatis-plus.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- ==================== Web ==================== -->
        <!-- Boot 4 的 artifact 名为 spring-boot-starter-webmvc（Boot 3 为 spring-boot-starter-web） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <!-- Boot 4 将 Jackson 拆为独立 starter，使用 Jackson 3（tools.jackson） -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-jackson</artifactId>
        </dependency>

        <!--
          注意：本环境离线，本地仓库没有 hibernate-validator / jakarta.validation，
          因此不引入 spring-boot-starter-validation。所有入参校验在 Service 层手写实现
          （见 docs/SHWordCloud_Standard_v2.0.md 的实现说明）。
        -->

        <!-- ==================== 持久层 ==================== -->
        <!-- 必须使用 boot4 坐标：spring-boot3-starter 在 Boot 4 下有启动失败风险 -->
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot4-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>

        <!-- ==================== Redis（Jedis 客户端） ==================== -->
        <!-- 排除 lettuce：本环境本地仓库无 lettuce-core；且要与 application.yaml 的 jedis.pool 配置键一致 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
            <exclusions>
                <exclusion>
                    <groupId>io.lettuce</groupId>
                    <artifactId>lettuce-core</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>redis.clients</groupId>
            <artifactId>jedis</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.commons</groupId>
            <artifactId>commons-pool2</artifactId>
        </dependency>

        <!-- ==================== 鉴权：Sa-Token ==================== -->
        <dependency>
            <groupId>cn.dev33</groupId>
            <artifactId>sa-token-spring-boot3-starter</artifactId>
            <version>${sa-token.version}</version>
        </dependency>

        <!-- ==================== 邮件（仅自助注册辅通道使用） ==================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>

        <!-- ==================== 阿里云 OSS ==================== -->
        <dependency>
            <groupId>com.aliyun.oss</groupId>
            <artifactId>aliyun-sdk-oss</artifactId>
            <version>${aliyun-oss.version}</version>
        </dependency>
        <!--
          STS 的 AssumeRole 走 aliyun-java-sdk-core 的 CommonRequest 通用调用
          （本环境离线，本地仓库无 aliyun-java-sdk-sts，改用通用 RPC 调用，见 StsService）。
        -->
        <dependency>
            <groupId>com.aliyun</groupId>
            <artifactId>aliyun-java-sdk-core</artifactId>
            <version>${aliyun-java-sdk-core.version}</version>
        </dependency>

        <!-- ==================== 工具 ==================== -->
        <dependency>
            <groupId>cn.hutool</groupId>
            <artifactId>hutool-all</artifactId>
            <version>${hutool.version}</version>
        </dependency>

        <!--
          Apache POI：只用于打开旧版 Word（.doc）的 OLE2 复合文档容器。
          .doc 的正文藏在 FIB + piece table 里，没法像 .docx 那样用 zip+xml 轻量提取；
          容器（CFB 的 FAT / MiniFAT / DIFAT 链）交给 POI 的 poifs 最稳妥，
          Word 侧的 FIB + piece table 由 TextExtractService 自己解析。
          注意：HWPF（org.apache.poi.hwpf）在 poi-scratchpad 里，本机离线取不到那个包，
          所以这里只引 poi 核心包（poifs 就在核心里），也不引 poi-ooxml。
          离线说明：poi:5.2.5 声明的 commons-codec 1.16.0 与 log4j-api 2.21.1
          在本机仓库里没有，但 Boot 父 pom 会把它们覆盖到已缓存的 1.21.0 / 2.25.5，因此可离线构建。
        -->
        <dependency>
            <groupId>org.apache.poi</groupId>
            <artifactId>poi</artifactId>
            <version>${poi.version}</version>
        </dependency>

        <dependency>
            <groupId>org.projectlombok</groupId>
            <artifactId>lombok</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- ==================== 测试 ==================== -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessorPaths>
                        <path>
                            <groupId>org.projectlombok</groupId>
                            <artifactId>lombok</artifactId>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>

</project>
